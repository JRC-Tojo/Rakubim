{
  "files.exclude": {
    "**/~$*": true
  },
  "editor.tabSize": 2,
  "files.encoding": "shiftjis",
  "files.autoGuessEncoding": false,
  "[json]": {
    "files.encoding": "utf8"
  },
  "[markdown]": {
    "files.encoding": "utf8"
  },
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.defaultColorDecorators": "never",
    "files.encoding": "utf8",
    "editor.quickSuggestions": {
      "strings": "on"
    }
  }
}